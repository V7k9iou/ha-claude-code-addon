#!/usr/bin/env bashio
# ==============================================================================
# The bridge is written to never exit (it reconnects forever). If it does die,
# halt the add-on so the Supervisor restarts the whole container rather than
# s6 restarting the process in a tight loop.
# ==============================================================================

declare exit_code=${1}

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "companion exited with code ${exit_code}; halting add-on for restart"
    echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi

bashio::log.info "companion exited cleanly"

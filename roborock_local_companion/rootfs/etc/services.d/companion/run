#!/usr/bin/with-contenv bashio
# ==============================================================================
# Roborock Local Companion — the long-running bridge. Reads the add-on options,
# resolves MQTT credentials (explicit options win, else the Supervisor's MQTT
# service), and execs the Python service. s6 supervises it; ./finish runs if
# it exits.
# ==============================================================================
set -e

for key in robot_ip device_id local_key; do
    if ! bashio::config.has_value "${key}"; then
        bashio::exit.nok "Option '${key}' must be set. See DOCS.md for how to obtain it."
    fi
done

export ROBOT_IP="$(bashio::config 'robot_ip')"
export ROBOT_DUID="$(bashio::config 'device_id')"
export ROBOT_LOCAL_KEY="$(bashio::config 'local_key')"
export DEVICE_NAME="$(bashio::config 'device_name' 'Roborock vacuum')"
export SUGGESTED_AREA="$(bashio::config 'suggested_area' '')"
export POLL_INTERVAL="$(bashio::config 'poll_interval' '30')"
export MAPS_REFRESH_INTERVAL="$(bashio::config 'maps_refresh_interval' '600')"
export ROOM_SETTINGS_MAP="$(bashio::config 'room_settings_map' 'Main floor')"
export DISCOVERY_PREFIX="$(bashio::config 'discovery_prefix' 'homeassistant')"
export LOG_LEVEL="$(bashio::config 'log_level' 'info')"
export ADDON_VERSION="$(bashio::addon.version)"

if bashio::config.has_value 'mqtt_host'; then
    bashio::log.info "Using MQTT broker from add-on options"
    export MQTT_HOST="$(bashio::config 'mqtt_host')"
    export MQTT_PORT="$(bashio::config 'mqtt_port' '1883')"
    export MQTT_USERNAME="$(bashio::config 'mqtt_username' '')"
    export MQTT_PASSWORD="$(bashio::config 'mqtt_password' '')"
else
    if ! bashio::services.available mqtt; then
        bashio::exit.nok "No MQTT service available. Install/start the Mosquitto broker add-on, or set mqtt_host in the options."
    fi
    bashio::log.info "Using MQTT broker from the Supervisor MQTT service"
    export MQTT_HOST="$(bashio::services mqtt 'host')"
    export MQTT_PORT="$(bashio::services mqtt 'port')"
    export MQTT_USERNAME="$(bashio::services mqtt 'username')"
    export MQTT_PASSWORD="$(bashio::services mqtt 'password')"
fi

bashio::log.info "Starting Roborock Local Companion for ${ROBOT_IP} (${ROBOT_DUID})"
exec /opt/venv/bin/python /opt/companion/companion.py
